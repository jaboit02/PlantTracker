# Ignore compiled Java classes and build artifacts
*.class
target/

# Ignore package files generated by building the application
*.jar
*.war
*.nar
*.ear

# Ignore compression formats
*.zip
*.tar.gz
*.rar

# Ignore general log files and JVM crash logs
*.log
hs_err_pid*
replay_pid*

# Ignore Node Modules
node_modules/

# Ignore Angular configuration
dist/

# Ignore VS Code configuration
.vscode/

# Ignore IntelliJ IDEA project files
.idea/
*.iml
*.iws

# Ignore Eclipse project files
.settings/
.project
.classpath

# Ignore Docker PostgreSQL local persistence storage
database/postgres_data/
database/backups/

# Ignore any environment secret files anywhere in the project hierarchy
.env
*.env

# Ignore any local fallback Spring properties files
application-local.properties

# Ignore Project Setup Scripts
GitHubSSHsetup.sh
VMsetup.sh
remakeDockerAndDB.sh
